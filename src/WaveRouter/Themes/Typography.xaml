<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Font families: Segoe UI Variable is the native Windows 11 font — premium and zero embedding cost.
         Cascadia Code covers technical/mono content (executable names, paths, logs). -->
    <FontFamily x:Key="FontPrimary">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas</FontFamily>

    <!-- Scale -->
    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">13</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXl">20</sys:Double>
    <sys:Double x:Key="FontSize2xl">24</sys:Double>
    <sys:Double x:Key="FontSize3xl">32</sys:Double>

    <!-- Weights -->
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- Line heights (used as LineHeight on TextBlock where needed) -->
    <sys:Double x:Key="LineHeightBody">19.6</sys:Double>
    <!-- 14 * 1.4 -->
    <sys:Double x:Key="LineHeightHeading">1.2</sys:Double>

</ResourceDictionary>
