<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Soft, non-rounded corners — consistent with the Fluent/Windows 11 look, never claymorphic. -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <!-- inputs, badges -->
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <!-- cards, panels -->
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <!-- window chrome, dialogs -->

</ResourceDictionary>
