<Window x:Class="WaveRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WaveRouter.Converters"
        xmlns:loc="clr-namespace:WaveRouter.Localization"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="WaveRouter"
        Width="760" Height="500" MinWidth="480" MinHeight="360"
        Background="{DynamicResource BgBaseBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!-- Groups the rule list by track (e.g. "Game", "Music") instead of a flat app list — live so
             typing a new track name for a rule moves it into the right group immediately. -->
        <CollectionViewSource x:Key="RulesByTrack" Source="{Binding Rules}" IsLiveGroupingRequested="True">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="TrackName" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.LiveGroupingProperties>
                <sys:String>TrackName</sys:String>
            </CollectionViewSource.LiveGroupingProperties>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="TrackName" />
                <scm:SortDescription PropertyName="ExecutableName" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>

        <!-- Persistence warning/error banner -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingCard}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Command="{Binding ClearStatusMessageCommand}"
                        ToolTip="{loc:Translate MainWindow.DismissStatus}"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WarningBrush}"
                        Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rule list sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="{StaticResource PaddingCard}">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Translate MainWindow.RulesHeading}" Style="{StaticResource Heading}"
                               Margin="0,0,0,16" />

                    <Button DockPanel.Dock="Bottom" Content="{loc:Translate MainWindow.AddRule}" Style="{StaticResource AccentButton}"
                            Command="{Binding AddRuleCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />

                    <Button DockPanel.Dock="Bottom" Content="{loc:Translate MainWindow.ImportExisting}"
                            Command="{Binding ImportExistingAssignmentsCommand}" HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" ToolTip="{loc:Translate MainWindow.ImportExistingTooltip}" />

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Translate MainWindow.NoRulesYet}"
                               TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox ItemsSource="{Binding Source={StaticResource RulesByTrack}}" SelectedItem="{Binding SelectedRule}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The track is already the group header above — just the app name here. -->
                                <TextBlock Text="{Binding ExecutableName}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSecondary}"
                                                   FontWeight="{StaticResource FontWeightSemiBold}"
                                                   Margin="0,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail / empty state -->
            <Grid Grid.Column="1" Background="{DynamicResource BgBaseBrush}">

                <!-- Empty state: shown when no rule is selected -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Margin="0,0,5,0" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.4" />
                        <Rectangle Width="4" Height="26" RadiusX="2" RadiusY="2" Margin="0,0,5,0" Fill="{DynamicResource AccentBrush}" Opacity="0.6" />
                        <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Margin="0,0,5,0" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.4" />
                        <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Margin="0,0,5,0" Fill="{DynamicResource AccentBrush}" Opacity="0.6" />
                        <Rectangle Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.4" />
                    </StackPanel>

                    <TextBlock Text="{loc:Translate MainWindow.SelectOrAddRule}"
                               Style="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Detail form: shown when a rule is selected -->
                <Border Style="{StaticResource Card}" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="{StaticResource PaddingCard}"
                        DataContext="{Binding SelectedRule}"
                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <StackPanel>

                        <TextBlock Text="{loc:Translate MainWindow.ExecutableLabel}" Style="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <TextBlock Text="{loc:Translate MainWindow.TrackLabel}" Style="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding DataContext.AvailableTracks, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding TrackName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,0,0,20" />

                        <TextBlock Text="{Binding DataContext.ValidationError, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding DataContext.ValidationError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibility}}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Translate MainWindow.Save}" Style="{StaticResource AccentButton}"
                                    Command="{Binding DataContext.SaveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,12,0" MinWidth="110" />
                            <Button Content="{loc:Translate MainWindow.Delete}"
                                    Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    MinWidth="110" />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

    </DockPanel>
</Window>
