<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subtle by design — never hard-edged. Shared across the app via StaticResource. -->
    <DropShadowEffect x:Key="ShadowSm" Color="Black" Opacity="0.15" BlurRadius="4" ShadowDepth="1" Direction="270" />
    <DropShadowEffect x:Key="ShadowMd" Color="Black" Opacity="0.25" BlurRadius="12" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="ShadowLg" Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="8" Direction="270" />

</ResourceDictionary>
