<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Durations, as Duration (for Storyboards) -->
    <Duration x:Key="DurationFast">0:0:0.15</Duration>
    <Duration x:Key="DurationBase">0:0:0.25</Duration>
    <Duration x:Key="DurationSlow">0:0:0.4</Duration>

    <!-- Easing — cubic-bezier(0.4, 0, 0.2, 1) equivalent -->
    <CubicEase x:Key="EasingStandard" EasingMode="EaseInOut" />

</ResourceDictionary>
