<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- WinForms is kept solely for System.Windows.Forms.NotifyIcon — WPF has no native tray icon API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- InvariantGlobalization is incompatible with WPF's text layout engine (it needs real culture data
         for font shaping) — removed now that the app renders WPF text, not just WinForms menus. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaveRouter.Core\WaveRouter.Core.csproj" />
    <ProjectReference Include="..\WaveRouter.Infrastructure\WaveRouter.Infrastructure.csproj" />
  </ItemGroup>

</Project>